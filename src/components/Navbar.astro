---
const socials = [
  {
    name: 'X / Twitter',
    href: 'https://x.com/jaren11111',
  },
  {
    name: 'YouTube',
    href: 'https://youtube.com/@imjaren',
  },
  {
    name: 'GitHub',
    href: 'https://github.com/jarenm1',
  },
] as const;

const pages = [
  {
    name: 'Home',
    href: '/',
  },
]

---

<nav class="sticky top-0 z-50 border-b border-neutral-800/80 bg-neutral-950/80 text-neutral-100 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 text-sm md:flex">
      {pages.map(({ name, href }) => (
        <a href={href} class="nav-link text-xl font-display tracking-tight">
          {name}
        </a>
      ))}
    </div>
    <div class="hidden items-center gap-4 text-sm md:flex">
      {socials.map(({ name, href }) => (
        <a
          href={href}
          class="nav-link"
          target="_blank"
          rel="noreferrer"
          aria-label={name}
        >
          {name}
        </a>
      ))}
    </div>

    <!-- Mobile nav -->
    <div class="relative flex w-full items-center justify-between md:hidden">
      <a href="/" class="nav-link text-xl font-display tracking-tight">
        Home
      </a>
      <button
        id="mobile-menu-btn"
        class="p-2 transition hover:text-neutral-50"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      
      <!-- Dropdown menu -->
      <div
        id="mobile-menu"
        class="absolute right-0 top-full mt-2 hidden w-48 border border-neutral-800 bg-neutral-950 py-2 shadow-lg"
      >
        <div class="border-b border-neutral-800 pb-2">
          {pages.map(({ name, href }) => (
            <a
              href={href}
              class="mobile-nav-link block px-4 py-2 text-sm"
            >
              {name}
            </a>
          ))}
        </div>
        <div class="pt-2">
          {socials.map(({ name, href }) => (
            <a
              href={href}
              class="mobile-nav-link block px-4 py-2 text-sm"
              target="_blank"
              rel="noreferrer"
            >
              {name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    
    // Toggle icon between hamburger and X
    if (isOpen) {
      menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
    } else {
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    }
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!menuBtn?.contains(e.target as Node) && !mobileMenu?.contains(e.target as Node)) {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    }
  });
</script>
