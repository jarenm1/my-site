<div class="recruiter-toggle">
  <button id="recruiter-toggle" type="button" aria-pressed="false">
    [ recruiter mode: <span id="recruiter-state">off</span> ]
  </button>
</div>

<script>
  const btn = document.getElementById('recruiter-toggle')!;
  const state = document.getElementById('recruiter-state')!;

  function apply(on: boolean) {
    document.documentElement.classList.toggle('recruiter-mode', on);
    btn.setAttribute('aria-pressed', String(on));
    state.textContent = on ? 'on' : 'off';
  }

  apply(localStorage.getItem('recruiter-mode') === '1');

  btn.addEventListener('click', () => {
    const on = !document.documentElement.classList.contains('recruiter-mode');
    localStorage.setItem('recruiter-mode', on ? '1' : '0');
    apply(on);
  });
</script>

<style>
  .recruiter-toggle {
    display: flex;
    justify-content: center;
    margin: -1.5rem 0 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .recruiter-toggle button {
    color: #737373;
    padding: 0.5rem 0.75rem;
    transition: color 0.2s ease;
    cursor: pointer;
  }
  .recruiter-toggle button:hover {
    color: #f5f5f5;
  }
  .recruiter-toggle button[aria-pressed="true"] {
    color: #d4d4d4;
  }
</style>
