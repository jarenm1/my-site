---
interface Props {
  chart: string;
}

const { chart } = Astro.props;
---

<div class="mermaid-wrapper my-6">
  <pre class="mermaid">{chart}</pre>
</div>

<script>
  function initMermaid() {
    const wrappers = document.querySelectorAll('.mermaid-wrapper:not(.initialized)');
    if (wrappers.length === 0) return;

    if (!window.mermaid) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      script.onload = () => {
        window.mermaid = mermaid;
        window.mermaid.initialize({ theme: 'dark', startOnLoad: false });
        renderMermaid();
      };
      document.head.appendChild(script);
    } else {
      renderMermaid();
    }

    function renderMermaid() {
      wrappers.forEach((wrapper) => {
        wrapper.classList.add('initialized');
        const pre = wrapper.querySelector('.mermaid');
        if (pre) {
          window.mermaid.run({ nodes: [pre] }).catch(console.error);
        }
      });
    }
  }

  initMermaid();
  document.addEventListener('astro:page-load', initMermaid);
</script>
