---
// Prototype: three business-card compositions on /, selected with ?variant=A|B|C.
---
<header class="card-prototype" data-variant="C">
  <div class="card-intro">
    <h1>Jaren McHugh</h1>
    <p class="intro-description">Austin, TX, Systems and ML</p>
  </div>
  <div class="card-stage" tabindex="0" role="img" aria-label="Business card. Drag to rotate, or use arrow keys. Home resets the view."></div>
  <div class="card-caption">
    <nav aria-label="Contact links">
      <a href="https://x.com/jaren11111" target="_blank" rel="noreferrer">x.com/jaren11111</a>
      <a href="https://github.com/jarenm1" target="_blank" rel="noreferrer">github.com/jarenm1</a>
    </nav>
  </div>
</header>
{import.meta.env.DEV && <aside class="prototype-switcher" aria-label="Prototype variants">
  <span class="draft-label">DRAFT</span>
  <button type="button" data-direction="-1" aria-label="Previous variant">←</button>
  <output aria-live="polite">C · Typeset</output>
  <button type="button" data-direction="1" aria-label="Next variant">→</button>
</aside>}

<script>
  import * as THREE from 'three';
  import { RoundedBoxGeometry } from 'three/addons/geometries/RoundedBoxGeometry.js';
  import QRCode from 'qrcode';

  const root = document.querySelector<HTMLElement>('.card-prototype')!;
  const stage = root.querySelector<HTMLElement>('.card-stage')!;
  const variants = ['A', 'B', 'C'];
  const names = ['On paper', 'The introduction', 'Typeset'];
  const requested = new URL(location.href).searchParams.get('variant');
  let variant = variants.includes(requested ?? '') ? requested! : 'C';
  root.dataset.variant = variant;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
  camera.position.set(0, 0, 5.8);
  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  stage.append(renderer.domElement);
  renderer.domElement.setAttribute('aria-hidden', 'true');

  scene.add(new THREE.AmbientLight(0xffffff, 1.2));
  const key = new THREE.DirectionalLight(0xfff4df, 1.8);
  key.position.set(-3, 4, 6);
  key.castShadow = true;
  key.shadow.mapSize.set(1024, 1024);
  key.shadow.camera.left = -4;
  key.shadow.camera.right = 4;
  key.shadow.camera.top = 4;
  key.shadow.camera.bottom = -4;
  key.shadow.normalBias = 0.025;
  key.shadow.radius = 5;
  scene.add(key);
  const fill = new THREE.DirectionalLight(0xcddaff, 0.6);
  fill.position.set(4, -1, 3);
  scene.add(fill);

  const artwork = document.createElement('canvas');
  artwork.width = 1400;
  artwork.height = 800;
  const ctx = artwork.getContext('2d')!;
  const texture = new THREE.CanvasTexture(artwork);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
  const grain = document.createElement('canvas');
  grain.width = grain.height = 256;
  const grainContext = grain.getContext('2d')!;
  const pixels = grainContext.createImageData(256, 256);
  for (let i = 0; i < pixels.data.length; i += 4) {
    const value = 120 + Math.random() * 60;
    pixels.data[i] = pixels.data[i + 1] = pixels.data[i + 2] = value;
    pixels.data[i + 3] = 255;
  }
  grainContext.putImageData(pixels, 0, 0);
  const bump = new THREE.CanvasTexture(grain);
  bump.wrapS = bump.wrapT = THREE.RepeatWrapping;
  bump.repeat.set(7, 4);
  const paper = new THREE.MeshStandardMaterial({ color: 0x303030, roughness: 0.9, bumpMap: bump, bumpScale: 0.0003 });
  const ink = new THREE.MeshStandardMaterial({ map: texture, roughness: 0.88 });
  const card = new THREE.Group();
  const body = new THREE.Mesh(new RoundedBoxGeometry(3.5, 2, 0.045, 3, 0.022), paper);
  body.castShadow = true;
  card.add(body);
  const face = new THREE.Mesh(new THREE.PlaneGeometry(3.465, 1.965), ink);
  face.position.z = 0.023;
  card.add(face);
  const backArtwork = document.createElement('canvas');
  backArtwork.width = 1400;
  backArtwork.height = 800;
  const backContext = backArtwork.getContext('2d')!;
  backContext.fillStyle = '#202020';
  backContext.fillRect(0, 0, 1400, 800);
  const qr = document.createElement('canvas');
  await QRCode.toCanvas(qr, 'https://jarenmchugh.com', {
    width: 560,
    margin: 4,
    errorCorrectionLevel: 'M',
    color: { dark: '#101010', light: '#ffffff' },
  });
  backContext.drawImage(qr, (1400 - qr.width) / 2, 80);
  const backTexture = new THREE.CanvasTexture(backArtwork);
  backTexture.colorSpace = THREE.SRGBColorSpace;
  backTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();
  const back = new THREE.Mesh(
    new THREE.PlaneGeometry(3.465, 1.965),
    new THREE.MeshStandardMaterial({ map: backTexture, roughness: 0.88 }),
  );
  back.rotation.y = Math.PI;
  back.position.z = -0.023;
  card.add(back);
  scene.add(card);
  const shadow = new THREE.Mesh(new THREE.PlaneGeometry(20, 20), new THREE.ShadowMaterial({ opacity: 0.32 }));
  shadow.position.z = -2;
  shadow.receiveShadow = true;
  scene.add(shadow);

  function text(value: string, x: number, y: number, size: number, family = 'IBM Plex Mono', color = '#b5b5b5') {
    ctx.fillStyle = color;
    ctx.font = `400 ${size}px "${family}"`;
    ctx.fillText(value, x, y);
  }
  function drawArtwork() {
    ctx.fillStyle = '#202020';
    ctx.fillRect(0, 0, 1400, 800);
    // Small pigment variations are baked once, not generated on every frame.
    for (let i = 0; i < 26000; i++) {
      ctx.fillStyle = `rgba(255, 255, 255, ${Math.random() * 0.025})`;
      ctx.fillRect(Math.random() * 1400, Math.random() * 800, 1.5, 1.5);
    }
    if (variant === 'C') {
      text('Jaren', 85, 270, 206, 'Noto Serif', '#f5f5f5');
      text('McHugh', 75, 483, 206, 'Noto Serif', '#f5f5f5');
      ctx.fillStyle = '#555555';
      ctx.fillRect(88, 557, 1224, 2);
      text('Austin, TX, Systems and ML', 88, 622, 36, 'Inter');
    } else if (variant === 'B') {
      ctx.fillStyle = '#555555';
      ctx.fillRect(100, 100, 2, 600);
      text('Jaren McHugh', 165, 310, 104, 'Noto Serif', '#f5f5f5');
      text('Austin, TX, Systems and ML', 170, 390, 40, 'Inter');
    } else {
      text('Jaren McHugh', 94, 335, 104, 'Noto Serif', '#f5f5f5');
      text('Austin, TX, Systems and ML', 100, 414, 40, 'Inter');
    }
    texture.needsUpdate = true;
  }

  let targetX = 0;
  let targetY = 0;
  let frame = 0;
  let spinX = 0;
  let spinY = 0;
  let drag: { id: number; x: number; y: number } | null = null;
  function render() {
    const smoothing = reducedMotion.matches || drag ? 1 : 0.12;
    card.rotation.x += (spinX + targetX - card.rotation.x) * smoothing;
    card.rotation.y += (spinY + targetY - card.rotation.y) * smoothing;
    renderer.render(scene, camera);
    const distance = Math.abs(spinX + targetX - card.rotation.x) + Math.abs(spinY + targetY - card.rotation.y);
    frame = distance > 0.0001 ? requestAnimationFrame(render) : 0;
  }
  function requestRender() {
    if (!frame) frame = requestAnimationFrame(render);
  }
  function resize() {
    const { width, height } = stage.getBoundingClientRect();
    renderer.setSize(width, height);
    camera.aspect = width / height;
    camera.position.z = Math.max(5.4, 4.05 / (2 * Math.tan(THREE.MathUtils.degToRad(16)) * camera.aspect));
    camera.updateProjectionMatrix();
    requestRender();
  }
  new ResizeObserver(resize).observe(stage);
  stage.addEventListener('pointerdown', (event) => {
    if (event.button !== 0 || drag) return;
    drag = { id: event.pointerId, x: event.clientX, y: event.clientY };
    targetX = targetY = 0;
    stage.setPointerCapture(event.pointerId);
    stage.classList.add('is-dragging');
    stage.focus({ preventScroll: true });
    requestRender();
  });
  stage.addEventListener('pointermove', (event) => {
    if (drag) {
      if (event.pointerId !== drag.id) return;
      spinY += (event.clientX - drag.x) / stage.clientWidth * Math.PI * 2;
      if (event.pointerType !== 'touch') spinX += (event.clientY - drag.y) / stage.clientHeight * Math.PI;
      drag.x = event.clientX;
      drag.y = event.clientY;
      requestRender();
      return;
    }
    if (reducedMotion.matches || event.pointerType === 'touch') return;
    const bounds = stage.getBoundingClientRect();
    targetY = ((event.clientX - bounds.left) / bounds.width - 0.5) * 0.25;
    targetX = ((event.clientY - bounds.top) / bounds.height - 0.5) * 0.18;
    requestRender();
  });
  stage.addEventListener('pointerleave', () => {
    if (drag) return;
    targetX = targetY = 0;
    requestRender();
  });
  function endDrag(event: PointerEvent) {
    if (drag?.id !== event.pointerId) return;
    drag = null;
    stage.classList.remove('is-dragging');
    if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
    requestRender();
  }
  stage.addEventListener('pointerup', endDrag);
  stage.addEventListener('pointercancel', endDrag);
  stage.addEventListener('lostpointercapture', endDrag);
  stage.addEventListener('keydown', (event) => {
    if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home'].includes(event.key)) return;
    event.preventDefault();
    event.stopPropagation();
    if (event.key === 'Home') spinX = spinY = 0;
    if (event.key === 'ArrowLeft') spinY -= Math.PI / 4;
    if (event.key === 'ArrowRight') spinY += Math.PI / 4;
    if (event.key === 'ArrowUp') spinX -= Math.PI / 4;
    if (event.key === 'ArrowDown') spinX += Math.PI / 4;
    targetX = targetY = 0;
    requestRender();
  });
  function applyVariant() {
    root.dataset.variant = variant;
    const label = document.querySelector('output');
    if (label) label.textContent = `${variant} · ${names[variants.indexOf(variant)]}`;
    drawArtwork();
    resize();
  }
  function cycle(direction: number) {
    variant = variants[(variants.indexOf(variant) + direction + variants.length) % variants.length];
    const url = new URL(location.href);
    url.searchParams.set('variant', variant);
    history.replaceState(null, '', url);
    applyVariant();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach(button => {
    button.addEventListener('click', () => cycle(Number(button.dataset.direction)));
  });
  if (import.meta.env.DEV) document.addEventListener('keydown', (event) => {
    if (event.target instanceof HTMLElement && event.target.closest('input, textarea, select, [contenteditable], [role="slider"]')) return;
    if (event.altKey || event.ctrlKey || event.metaKey) return;
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      cycle(event.key === 'ArrowLeft' ? -1 : 1);
    }
  });
  window.addEventListener('popstate', () => {
    const value = new URL(location.href).searchParams.get('variant');
    variant = variants.includes(value ?? '') ? value! : 'C';
    applyVariant();
  });
  await Promise.all([document.fonts.load('400 104px "Noto Serif"'), document.fonts.load('400 31px "IBM Plex Mono"'), document.fonts.load('400 40px "Inter"')]);
  backContext.fillStyle = '#b5b5b5';
  backContext.font = '400 32px "IBM Plex Mono"';
  backContext.textAlign = 'center';
  backContext.fillText('jarenmchugh.com', 700, 718);
  backTexture.needsUpdate = true;
  applyVariant();
  root.classList.add('is-rendered');
</script>

<style>
  .card-prototype { margin: -1.5rem -1rem 4rem; }
  .card-stage { height: 340px; width: 100%; min-width: 0; touch-action: pan-y; cursor: grab; }
  .card-stage.is-dragging { cursor: grabbing; }
  .card-stage:focus { outline: none; }
  .card-stage :global(canvas) { display: block; }
  .card-intro { text-align: center; padding: 2rem 1rem 0; }
  .card-intro h1 { font-family: var(--font-noto-serif); font-size: 2rem; letter-spacing: -0.04em; }
  .intro-description { color: #a3a3a3; font-size: 0.8rem; }
  .is-rendered:not([data-variant="B"]) .card-intro { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .card-caption { display: flex; justify-content: center; align-items: center; margin: 0 1rem; padding-top: 0.25rem; font-family: var(--font-mono); font-size: 0.75rem; }
  nav { display: flex; gap: 1.5rem; }
  nav a { color: #a3a3a3; text-decoration: underline; text-decoration-color: #404040; text-underline-offset: 4px; padding-block: 0.5rem; }
  nav a:hover { color: #f5f5f5; }
  [data-variant="B"] { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: center; margin-top: 1rem; }
  [data-variant="B"] .card-intro { text-align: left; padding: 0 0 0 1rem; }
  [data-variant="B"] .card-intro h1 { font-size: 2.3rem; line-height: 1.15; margin-bottom: 1rem; }
  [data-variant="B"] .card-stage { height: 280px; }
  [data-variant="B"] .card-caption { grid-column: 1 / -1; margin: 1rem 1rem 0; }
  [data-variant="C"] .card-stage { height: 385px; }
  [data-variant="C"] .card-caption { justify-content: center; }
  .prototype-switcher { position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); z-index: 100; display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.7rem; background: #eae5da; color: #292923; border: 1px solid #fff8; border-radius: 999px; box-shadow: 0 4px 24px #0006; font: 11px var(--font-mono); white-space: nowrap; }
  .draft-label { font-size: 9px; color: #7c776b; margin-inline: 0.3rem; }
  .prototype-switcher button { width: 30px; height: 30px; cursor: pointer; border-radius: 50%; }
  .prototype-switcher button:hover { background: #d7d0c3; }
  .prototype-switcher output { min-width: 155px; text-align: center; }
  @media (max-width: 520px) {
    .card-prototype { margin-top: -1rem; margin-bottom: 3rem; }
    .card-stage { height: 265px; }
    .card-caption { margin-inline: 1.4rem; font-size: 0.6rem; }
    .card-caption { justify-content: center; }
    [data-variant="B"] { display: flex; flex-direction: column; }
    [data-variant="B"] .card-intro { text-align: center; padding: 1rem 1rem 0; }
    [data-variant="B"] .card-stage { height: 255px; }
    [data-variant="B"] .card-caption { margin-top: 0; }
    [data-variant="C"] .card-stage { height: 290px; }
  }
</style>
