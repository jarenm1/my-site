---
const birthday = new Date('2004-09-22');
const today = new Date();
let age = today.getFullYear() - birthday.getFullYear();
const monthDiff = today.getMonth() - birthday.getMonth();
if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthday.getDate())) {
  age--;
}
---

<div>
  <p class="font-mono text-xs tracking-widest uppercase mb-5">Jaren McHugh</p>
  <ul class="font-display text-xl md:text-2xl font-medium leading-snug tracking-[-0.015em] space-y-3">
    <li>Age {age}</li>
    <li>Austin, TX.</li>
    <li>Rust + systems, Amateur ML research</li>
  </ul>
  <a
    href="https://x.com/jaren11111"
    target="_blank"
    rel="noreferrer"
    aria-label="Jaren McHugh on X"
    class="mt-8 inline-flex text-neutral-400 transition-colors duration-200 hover:text-neutral-50"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
    </svg>
  </a>
</div>
