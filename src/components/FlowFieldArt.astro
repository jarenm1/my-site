---
---

<canvas id="flow-field-canvas" class="mx-auto pointer-events-none opacity-20"></canvas>

<script>
  const canvas = document.getElementById('flow-field-canvas') as HTMLCanvasElement;
  const context = canvas.getContext('2d');
  
  if (context) {
    const ctx = context;
    const size = 400;
    canvas.width = size;
    canvas.height = size;
    
    const particles: Particle[] = [];
    const particleCount = 20;
    const wallGlows: { radius: number; angle: number; time: number; isFinish: boolean }[] = [];
    const centerX = size / 2;
    const centerY = size / 2;
    
    // Maze: concentric rings with gaps (grouped by radius)
    interface MazeRing {
      radius: number;
      gaps: { start: number; end: number }[];  // angles in radians
    }
    
    const mazeRings: MazeRing[] = [
      { radius: 60, gaps: [
        { start: Math.PI * 0.4, end: Math.PI * 0.6 },
        { start: Math.PI * 1.4, end: Math.PI * 1.6 }
      ]},
      { radius: 110, gaps: [
        { start: Math.PI * 0.9, end: Math.PI * 1.1 },
        { start: Math.PI * 1.7, end: Math.PI * 1.9 }
      ]},
      { radius: 160, gaps: [
        { start: Math.PI * 0.15, end: Math.PI * 0.45 },
        { start: Math.PI * 1.15, end: Math.PI * 1.45 }
      ]},
    ];
    
    const wallThickness = 6;
    const outerRadius = size / 2 - 10;
    
    // Check if angle is within a gap
    function isInGap(angle: number, gaps: { start: number; end: number }[]): boolean {
      let normalizedAngle = angle < 0 ? angle + Math.PI * 2 : angle;
      if (normalizedAngle > Math.PI * 2) normalizedAngle -= Math.PI * 2;
      
      for (const gap of gaps) {
        if (normalizedAngle >= gap.start && normalizedAngle <= gap.end) {
          return true;
        }
      }
      return false;
    }
    
    // Check collision: returns 'wall' for inner walls, 'finish' for outer, 'none' for safe
    function checkCollision(x: number, y: number): { type: 'wall' | 'finish' | 'none'; radius: number; angle: number } {
      const dx = x - centerX;
      const dy = y - centerY;
      const dist = Math.sqrt(dx * dx + dy * dy);
      const angle = Math.atan2(dy, dx);
      
      // Check outer boundary - this is the FINISH LINE
      if (dist > outerRadius) {
        return { type: 'finish', radius: outerRadius, angle };
      }
      
      // Check each ring wall
      for (const ring of mazeRings) {
        if (dist > ring.radius - wallThickness / 2 && dist < ring.radius + wallThickness / 2) {
          if (!isInGap(angle, ring.gaps)) {
            return { type: 'wall', radius: ring.radius, angle };
          }
        }
      }
      
      return { type: 'none', radius: 0, angle: 0 };
    }
    
    // Sensor: cast a ray and find distance to nearest wall
    const SENSOR_RANGE = 50;
    
    function senseWall(x: number, y: number, angle: number): number {
      // Returns 0-1: 0 = no wall in range, 1 = wall very close
      for (let dist = 2; dist <= SENSOR_RANGE; dist += 2) {
        const testX = x + Math.cos(angle) * dist;
        const testY = y + Math.sin(angle) * dist;
        const collision = checkCollision(testX, testY);
        if (collision.type === 'wall') {
          return 1 - (dist / SENSOR_RANGE); // Closer = higher value
        }
        if (collision.type === 'finish') {
          return 0; // Don't avoid the finish line!
        }
      }
      return 0;
    }
    
    // Genes interface for evolvable traits - sensor-based steering
    interface Genes {
      initialAngle: number;      // starting direction (0 to 2π)
      leftWeight: number;        // turn response to left sensor (-0.1 to 0.1)
      rightWeight: number;       // turn response to right sensor (-0.1 to 0.1)
      forwardWeight: number;     // turn response to forward sensor (-0.1 to 0.1)
      baseTurn: number;          // constant turn bias (-0.02 to 0.02)
    }
    
    const PARTICLE_SPEED = 1.2; // Faster for maze navigation
    
    class Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      currentAngle: number;
      history: { x: number; y: number }[];
      maxHistory: number;
      genes: Genes;
      finishTime: number;  // frames to finish (lower = better), 0 = didn't finish
      survivalTime: number;  // frames survived (for non-finishers)
      endDistance: number;  // distance from center when died
      alive: boolean;
      finished: boolean;
      startDelay: number;
      age: number;
      
      constructor(genes?: Genes) {
        // Start at center
        this.x = centerX;
        this.y = centerY;
        
        // Use provided genes or generate random ones
        this.genes = genes || {
          initialAngle: Math.random() * Math.PI * 2,
          leftWeight: (Math.random() - 0.5) * 0.2,    // -0.1 to 0.1
          rightWeight: (Math.random() - 0.5) * 0.2,   // -0.1 to 0.1
          forwardWeight: (Math.random() - 0.5) * 0.2, // -0.1 to 0.1
          baseTurn: (Math.random() - 0.5) * 0.04      // -0.02 to 0.02
        };
        
        // Use gene for starting direction
        this.currentAngle = this.genes.initialAngle;
        
        // Random start delay
        this.startDelay = Math.random() * 60;
        this.age = 0;
        this.finishTime = 0;
        this.survivalTime = 0;
        this.endDistance = 0;
        this.alive = true;
        this.finished = false;
        
        this.vx = 0;
        this.vy = 0;
        this.history = [];
        this.maxHistory = 80;
      }
      
      update(): { type: 'wall' | 'finish' | 'none'; radius: number; angle: number } {
        if (!this.alive) {
          return { type: 'none', radius: 0, angle: 0 };
        }
        
        this.age++;
        
        if (this.age < this.startDelay) {
          return { type: 'none', radius: 0, angle: 0 };
        }
        
        // Track survival time
        this.survivalTime++;
        
        // Sense walls in 3 directions
        const leftAngle = this.currentAngle - Math.PI / 4;   // 45° left
        const rightAngle = this.currentAngle + Math.PI / 4;  // 45° right
        
        const leftSensor = senseWall(this.x, this.y, leftAngle);
        const rightSensor = senseWall(this.x, this.y, rightAngle);
        const forwardSensor = senseWall(this.x, this.y, this.currentAngle);
        
        // Calculate turn based on sensors and genes
        // Positive turn = clockwise (right), negative = counter-clockwise (left)
        const turn = this.genes.baseTurn +
          leftSensor * this.genes.leftWeight +
          rightSensor * this.genes.rightWeight +
          forwardSensor * this.genes.forwardWeight;
        
        this.currentAngle += turn;
        
        // Calculate new position
        this.vx = Math.cos(this.currentAngle) * PARTICLE_SPEED;
        this.vy = Math.sin(this.currentAngle) * PARTICLE_SPEED;
        
        const newX = this.x + this.vx;
        const newY = this.y + this.vy;
        
        // Check collision
        const collision = checkCollision(newX, newY);
        
        if (collision.type === 'finish') {
          // WINNER! Record finish time
          this.finishTime = this.age - this.startDelay;
          this.finished = true;
          this.alive = false;
          return { type: 'finish', radius: collision.radius, angle: collision.angle };
        }
        
        if (collision.type === 'wall') {
          // Hit a wall, dead - record end distance
          this.endDistance = Math.sqrt((this.x - centerX) ** 2 + (this.y - centerY) ** 2);
          this.alive = false;
          this.history = [];
          return { type: 'wall', radius: collision.radius, angle: collision.angle };
        }
        
        this.history.push({ x: this.x, y: this.y });
        if (this.history.length > this.maxHistory) {
          this.history.shift();
        }
        
        this.x = newX;
        this.y = newY;
        
        return { type: 'none', radius: 0, angle: 0 };
      }
      
      reset(newGenes?: Genes) {
        this.x = centerX;
        this.y = centerY;
        this.history = [];
        this.age = 0;
        this.finishTime = 0;
        this.survivalTime = 0;
        this.endDistance = 0;
        this.alive = true;
        this.finished = false;
        this.startDelay = Math.random() * 60;
        
        if (newGenes) {
          this.genes = newGenes;
        }
        this.currentAngle = this.genes.initialAngle;
      }
      
      draw(ctx: CanvasRenderingContext2D) {
        if (this.history.length < 2) return;
        
        ctx.beginPath();
        ctx.moveTo(this.history[0].x, this.history[0].y);
        
        for (let i = 1; i < this.history.length; i++) {
          ctx.lineTo(this.history[i].x, this.history[i].y);
        }
        
        // Green tint for finished particles
        const color = this.finished ? 'rgba(147, 253, 180, 0.6)' : 'rgba(147, 197, 253, 0.6)';
        ctx.strokeStyle = color;
        ctx.lineWidth = 1;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.stroke();
      }
    }
    
    // Mutation function
    function mutate(value: number, min: number, max: number): number {
      const mutationAmount = (max - min) * 0.15;
      const newValue = value + (Math.random() - 0.5) * mutationAmount;
      return Math.max(min, Math.min(max, newValue));
    }
    
    function mutateGenes(genes: Genes): Genes {
      // Mutate angle with wrap-around
      let newAngle = genes.initialAngle + (Math.random() - 0.5) * 0.5;
      if (newAngle < 0) newAngle += Math.PI * 2;
      if (newAngle > Math.PI * 2) newAngle -= Math.PI * 2;
      
      return {
        initialAngle: newAngle,
        leftWeight: mutate(genes.leftWeight, -0.1, 0.1),
        rightWeight: mutate(genes.rightWeight, -0.1, 0.1),
        forwardWeight: mutate(genes.forwardWeight, -0.1, 0.1),
        baseTurn: mutate(genes.baseTurn, -0.02, 0.02)
      };
    }
    
    // Draw maze walls
    function drawMaze(ctx: CanvasRenderingContext2D) {
      ctx.strokeStyle = 'rgba(100, 100, 120, 0.6)';
      ctx.lineWidth = wallThickness;
      ctx.lineCap = 'round';
      
      // Draw outer circle (finish line) with slight green tint
      ctx.strokeStyle = 'rgba(100, 140, 120, 0.6)';
      ctx.beginPath();
      ctx.arc(centerX, centerY, outerRadius, 0, Math.PI * 2);
      ctx.stroke();
      
      // Draw ring walls with gaps
      ctx.strokeStyle = 'rgba(100, 100, 120, 0.6)';
      mazeRings.forEach(ring => {
        const sortedGaps = [...ring.gaps].sort((a, b) => a.start - b.start);
        
        let lastEnd = 0;
        sortedGaps.forEach(gap => {
          if (gap.start > lastEnd) {
            ctx.beginPath();
            ctx.arc(centerX, centerY, ring.radius, lastEnd, gap.start);
            ctx.stroke();
          }
          lastEnd = gap.end;
        });
        
        // Draw remaining arc after last gap
        if (lastEnd < Math.PI * 2) {
          ctx.beginPath();
          ctx.arc(centerX, centerY, ring.radius, lastEnd, Math.PI * 2);
          ctx.stroke();
        }
      });
    }
    
    // Generation management
    let generation = 1;
    let bestTime = Infinity;  // Lower is better (for finishers)
    let bestSurvival = 0;     // Higher is better (for non-finishers)
    let bestGenes: Genes | null = null;
    
    // Calculate fitness score: finishers always beat non-finishers
    function getFitness(particle: Particle): number {
      if (particle.finished) {
        // Finishers: 10000 base + bonus for speed (faster = higher)
        return 10000 + (1000 - particle.finishTime);
      } else {
        // Non-finishers: just distance from center when died
        return (particle.endDistance / outerRadius) * 2000;
      }
    }
    
    function startNewGeneration() {
      // Find the best performer this generation
      let currentBestFitness = 0;
      let currentBestGenes: Genes | null = null;
      let currentBestFinished = false;
      let currentBestFinishTime = Infinity;
      let currentBestSurvivalTime = 0;
      
      particles.forEach(particle => {
        const fitness = getFitness(particle);
        if (fitness > currentBestFitness) {
          currentBestFitness = fitness;
          currentBestGenes = { ...particle.genes };
          currentBestFinished = particle.finished;
          currentBestFinishTime = particle.finishTime;
          currentBestSurvivalTime = particle.survivalTime;
        }
      });
      
      // Update global bests
      if (currentBestGenes) {
        if (currentBestFinished) {
          if (currentBestFinishTime < bestTime) {
            bestTime = currentBestFinishTime;
            bestGenes = currentBestGenes;
          }
        } else if (bestTime === Infinity) {
          // No finisher yet, track survival
          if (currentBestSurvivalTime > bestSurvival) {
            bestSurvival = currentBestSurvivalTime;
            bestGenes = currentBestGenes;
          }
        }
      }
      
      // Use best genes or random if none
      const templateGenes = bestGenes || {
        initialAngle: Math.random() * Math.PI * 2,
        leftWeight: 0.05,    // Default: turn right when wall on left
        rightWeight: -0.05,  // Default: turn left when wall on right
        forwardWeight: 0,
        baseTurn: 0
      };
      
      particles.forEach(particle => {
        particle.reset(mutateGenes(templateGenes));
      });
      
      generation++;
    }
    
    // Initialize particles
    for (let i = 0; i < particleCount; i++) {
      particles.push(new Particle());
    }
    
    let time = 0;
    let generationStartTime = 0;
    const GENERATION_TIMEOUT = 600; // 10 seconds at 60fps
    
    function animate() {
      if (!ctx) return;
      
      // Fade effect
      ctx.fillStyle = 'rgba(10, 10, 10, 0.05)';
      ctx.fillRect(0, 0, size, size);
      
      // Draw maze
      drawMaze(ctx);
      
      // Check if all particles are dead OR timeout reached
      const allDead = particles.every(p => !p.alive);
      const timeout = (time - generationStartTime) > GENERATION_TIMEOUT;
      
      if (allDead || timeout) {
        // Record end distance for any still-alive particles (timeout case)
        particles.forEach(p => {
          if (p.alive) {
            p.endDistance = Math.sqrt((p.x - centerX) ** 2 + (p.y - centerY) ** 2);
            p.alive = false;
          }
        });
        generationStartTime = time;
        startNewGeneration();
      }
      
      particles.forEach(particle => {
        const result = particle.update();
        if (result.type === 'wall' || result.type === 'finish') {
          wallGlows.push({ radius: result.radius, angle: result.angle, time: time, isFinish: result.type === 'finish' });
        }
        if (ctx) particle.draw(ctx);
      });
      
      // Draw wall/finish hit effects (arc glows)
      wallGlows.forEach((glow, index) => {
        const age = time - glow.time;
        const maxAge = 60;
        
        if (age > maxAge) {
          wallGlows.splice(index, 1);
          return;
        }
        
        const opacity = 1 - (age / maxAge);
        const arcSpread = (age / maxAge) * 0.25;
        const lineWidth = 4 - (age / maxAge) * 2;
        
        // Green for finish, white for walls
        const color = glow.isFinish ? '100, 255, 150' : '255, 255, 255';
        
        // Outer glow layer
        ctx.beginPath();
        ctx.arc(centerX, centerY, glow.radius, glow.angle - arcSpread, glow.angle + arcSpread);
        ctx.strokeStyle = `rgba(${color}, ${opacity * 0.7})`;
        ctx.lineWidth = lineWidth * 1.5;
        ctx.lineCap = 'round';
        ctx.stroke();
        
        // Inner full glow layer
        ctx.beginPath();
        ctx.arc(centerX, centerY, glow.radius, glow.angle - arcSpread * 0.7, glow.angle + arcSpread * 0.7);
        ctx.strokeStyle = `rgba(${color}, ${opacity})`;
        ctx.lineWidth = lineWidth;
        ctx.lineCap = 'round';
        ctx.stroke();
      });
      
      // Draw generation UI
      let bestDisplay: string;
      if (bestTime < Infinity) {
        bestDisplay = (bestTime / 60).toFixed(1) + 's';
      } else {
        bestDisplay = '--';
      }
      ctx.font = '11px monospace';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
      ctx.textAlign = 'center';
      ctx.fillText(`Gen ${generation} | Best: ${bestDisplay}`, 10, size - 10);
      
      time++;
      requestAnimationFrame(animate);
    }
    
    // Initial clear
    ctx.fillStyle = 'rgb(10, 10, 10)';
    ctx.fillRect(0, 0, size, size);
    
    animate();
  }
</script>
