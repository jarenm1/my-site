<canvas
  id="apple-tesseract-canvas"
  class="block h-full w-full"
  role="img"
  aria-label="A rotating four-dimensional tesseract built entirely from three-dimensional apples"
></canvas>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('apple-tesseract-canvas') as HTMLCanvasElement;

  if (canvas) {
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 16 / 9, 0.1, 100);
    camera.position.set(0, 0.15, 6.4);

    const world = new THREE.Group();
    world.rotation.x = -0.16;
    scene.add(world);

    scene.add(new THREE.HemisphereLight(0xfff2df, 0x1b0a0a, 1.8));

    const keyLight = new THREE.DirectionalLight(0xfff0d5, 4.2);
    keyLight.position.set(-3, 4, 5);
    scene.add(keyLight);

    const rimLight = new THREE.PointLight(0xff2438, 18, 12);
    rimLight.position.set(3.5, 0.5, 3);
    scene.add(rimLight);

    const greenLight = new THREE.PointLight(0x84cc16, 6, 10);
    greenLight.position.set(-3, -2, 1);
    scene.add(greenLight);

    const vertices = Array.from({ length: 16 }, (_, index) => [
      index & 1 ? 1 : -1,
      index & 2 ? 1 : -1,
      index & 4 ? 1 : -1,
      index & 8 ? 1 : -1,
    ]);
    const edges: [number, number][] = [];

    for (let vertex = 0; vertex < 16; vertex++) {
      for (let axis = 0; axis < 4; axis++) {
        const neighbor = vertex ^ (1 << axis);
        if (vertex < neighbor) edges.push([vertex, neighbor]);
      }
    }

    const applesPerEdge = 5;
    const appleCount = vertices.length + edges.length * applesPerEdge;

    // Sculpt a high-resolution sphere into an asymmetric apple with shoulders,
    // four subtle lobes, and depressions at both the stem and blossom ends.
    const bodyRadius = 0.19;
    const bodyGeometry = new THREE.SphereGeometry(bodyRadius, 36, 28);
    const bodyPositions = bodyGeometry.attributes.position;
    for (let index = 0; index < bodyPositions.count; index++) {
      const x = bodyPositions.getX(index);
      const y = bodyPositions.getY(index);
      const z = bodyPositions.getZ(index);
      const angle = Math.atan2(z, x);
      const normalizedY = y / bodyRadius;
      const radialDistance = Math.hypot(x, z) / bodyRadius;
      const shoulder = 1.02 + normalizedY * 0.12 - normalizedY * normalizedY * 0.05;
      const lobes = 1 + Math.cos(angle * 4 + 0.18) * 0.045 * (0.55 + normalizedY * 0.45);
      const asymmetry = 1 + Math.sin(angle + 0.7) * 0.025;
      const topDimple = normalizedY > 0
        ? 0.052 * Math.exp(-(radialDistance * radialDistance) / 0.075)
        : 0;
      const bottomDimple = normalizedY < 0
        ? 0.018 * Math.exp(-(radialDistance * radialDistance) / 0.055)
        : 0;

      bodyPositions.setXYZ(
        index,
        x * shoulder * lobes * asymmetry,
        y * 0.91 - topDimple + bottomDimple,
        z * shoulder * lobes,
      );
    }
    bodyGeometry.computeVertexNormals();

    const stemCurve = new THREE.QuadraticBezierCurve3(
      new THREE.Vector3(0, -0.052, 0),
      new THREE.Vector3(0.013, 0.004, 0.004),
      new THREE.Vector3(0.032, 0.065, 0),
    );
    const stemGeometry = new THREE.TubeGeometry(stemCurve, 8, 0.014, 7, false);

    const leafShape = new THREE.Shape();
    leafShape.moveTo(0, 0);
    leafShape.bezierCurveTo(0.035, 0.052, 0.105, 0.065, 0.145, 0.014);
    leafShape.bezierCurveTo(0.105, -0.018, 0.038, -0.024, 0, 0);
    const leafGeometry = new THREE.ExtrudeGeometry(leafShape, {
      depth: 0.006,
      bevelEnabled: true,
      bevelSegments: 2,
      bevelSize: 0.004,
      bevelThickness: 0.003,
      curveSegments: 8,
    });
    leafGeometry.translate(-0.008, 0, -0.003);

    const calyxGeometry = new THREE.ConeGeometry(0.034, 0.018, 5);
    calyxGeometry.rotateX(Math.PI);

    const skinCanvas = document.createElement('canvas');
    skinCanvas.width = 256;
    skinCanvas.height = 128;
    const skinContext = skinCanvas.getContext('2d')!;
    const skinGradient = skinContext.createLinearGradient(0, 0, 0, skinCanvas.height);
    skinGradient.addColorStop(0, '#8f101f');
    skinGradient.addColorStop(0.36, '#f2474f');
    skinGradient.addColorStop(0.72, '#c51f31');
    skinGradient.addColorStop(1, '#72101d');
    skinContext.fillStyle = skinGradient;
    skinContext.fillRect(0, 0, skinCanvas.width, skinCanvas.height);

    let seed = 9187;
    for (let index = 0; index < 420; index++) {
      seed = (seed * 16807) % 2147483647;
      const x = (seed / 2147483647) * skinCanvas.width;
      seed = (seed * 16807) % 2147483647;
      const y = (seed / 2147483647) * skinCanvas.height;
      seed = (seed * 16807) % 2147483647;
      const radius = 0.25 + (seed / 2147483647) * 0.65;
      skinContext.fillStyle = index % 5 === 0 ? 'rgba(255, 225, 172, 0.22)' : 'rgba(77, 8, 18, 0.2)';
      skinContext.beginPath();
      skinContext.arc(x, y, radius, 0, Math.PI * 2);
      skinContext.fill();
    }
    const skinTexture = new THREE.CanvasTexture(skinCanvas);
    skinTexture.colorSpace = THREE.SRGBColorSpace;

    const bodyMaterial = new THREE.MeshPhysicalMaterial({
      color: 0xffffff,
      map: skinTexture,
      roughness: 0.34,
      metalness: 0,
      clearcoat: 0.42,
      clearcoatRoughness: 0.31,
      sheen: 0.16,
      sheenColor: new THREE.Color(0xffb8a3),
    });
    const stemMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x5c2f16,
      roughness: 0.88,
    });
    const leafMaterial = new THREE.MeshPhysicalMaterial({
      color: 0x56870d,
      roughness: 0.58,
      clearcoat: 0.12,
    });
    const calyxMaterial = new THREE.MeshStandardMaterial({ color: 0x3d2414, roughness: 0.94 });

    const bodies = new THREE.InstancedMesh(bodyGeometry, bodyMaterial, appleCount);
    const stems = new THREE.InstancedMesh(stemGeometry, stemMaterial, appleCount);
    const leaves = new THREE.InstancedMesh(leafGeometry, leafMaterial, appleCount);
    const calyxes = new THREE.InstancedMesh(calyxGeometry, calyxMaterial, appleCount);
    bodies.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    stems.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    leaves.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    calyxes.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    world.add(bodies, stems, leaves, calyxes);

    const transform = new THREE.Object3D();
    const appleRotation = new THREE.Quaternion();
    const localOffset = new THREE.Vector3();
    const appleScale = new THREE.Vector3();
    const red = new THREE.Color();

    function rotate(a: number, b: number, angle: number): [number, number] {
      const cosine = Math.cos(angle);
      const sine = Math.sin(angle);
      return [a * cosine - b * sine, a * sine + b * cosine];
    }

    function project(point: number[], time: number): THREE.Vector3 {
      let [x, y, z, w] = point;
      [x, w] = rotate(x, w, time * 0.48);
      [y, z] = rotate(y, z, time * 0.34);
      [z, w] = rotate(z, w, time * 0.27);
      [x, y] = rotate(x, y, time * 0.13);

      const perspective = 2.7 / (3.35 - w);
      return new THREE.Vector3(x, y, z).multiplyScalar(perspective * 1.23);
    }

    function interpolate4d(from: number[], to: number[], amount: number): number[] {
      return from.map((value, index) => THREE.MathUtils.lerp(value, to[index], amount));
    }

    function setApple(
      index: number,
      position: THREE.Vector3,
      scale: number,
      spin: number,
      isVertex: boolean,
    ) {
      appleRotation.setFromEuler(new THREE.Euler(0.04 * Math.sin(spin), spin, 0.06 * Math.cos(spin)));
      appleScale.set(
        scale * (1 + Math.sin(index * 2.17) * 0.035),
        scale * (0.98 + Math.cos(index * 1.31) * 0.025),
        scale * (1 + Math.sin(index * 0.87) * 0.025),
      );

      transform.position.copy(position);
      transform.quaternion.copy(appleRotation);
      transform.scale.copy(appleScale);
      transform.updateMatrix();
      bodies.setMatrixAt(index, transform.matrix);

      const colorNoise = Math.sin(index * 12.9898) * 0.5 + 0.5;
      red.setHSL(
        (isVertex ? 0.988 : 0.982) + colorNoise * 0.009,
        isVertex ? 0.86 : 0.76,
        (isVertex ? 0.54 : 0.43) + colorNoise * 0.045,
      );
      bodies.setColorAt(index, red);

      localOffset.set(0, 0.185 * scale, 0).applyQuaternion(appleRotation);
      transform.position.copy(position).add(localOffset);
      transform.quaternion.copy(appleRotation);
      transform.scale.setScalar(scale);
      transform.updateMatrix();
      stems.setMatrixAt(index, transform.matrix);

      localOffset.set(0.018 * scale, 0.245 * scale, 0).applyQuaternion(appleRotation);
      transform.position.copy(position).add(localOffset);
      transform.quaternion.copy(appleRotation);
      transform.rotateZ(-0.42);
      transform.scale.setScalar(scale);
      transform.updateMatrix();
      leaves.setMatrixAt(index, transform.matrix);

      localOffset.set(0, -0.175 * scale, 0).applyQuaternion(appleRotation);
      transform.position.copy(position).add(localOffset);
      transform.quaternion.copy(appleRotation);
      transform.scale.setScalar(scale);
      transform.updateMatrix();
      calyxes.setMatrixAt(index, transform.matrix);
    }

    let visible = true;
    let animationFrame = 0;

    function render(milliseconds: number) {
      const time = milliseconds / 1000;
      let appleIndex = 0;

      for (let index = 0; index < vertices.length; index++) {
        setApple(
          appleIndex++,
          project(vertices[index], time),
          1.42,
          time * 0.6 + index * 0.31,
          true,
        );
      }

      for (let edgeIndex = 0; edgeIndex < edges.length; edgeIndex++) {
        const [fromIndex, toIndex] = edges[edgeIndex];
        for (let step = 1; step <= applesPerEdge; step++) {
          const amount = step / (applesPerEdge + 1);
          const point = interpolate4d(vertices[fromIndex], vertices[toIndex], amount);
          setApple(
            appleIndex++,
            project(point, time),
            0.47,
            -time * 0.9 + edgeIndex * 0.22 + step,
            false,
          );
        }
      }

      bodies.instanceMatrix.needsUpdate = true;
      stems.instanceMatrix.needsUpdate = true;
      leaves.instanceMatrix.needsUpdate = true;
      calyxes.instanceMatrix.needsUpdate = true;
      if (bodies.instanceColor) bodies.instanceColor.needsUpdate = true;

      world.rotation.y = time * 0.08;
      world.rotation.z = Math.sin(time * 0.18) * 0.07;
      renderer.render(scene, camera);

      if (visible) animationFrame = requestAnimationFrame(render);
    }

    function resize() {
      const bounds = canvas.getBoundingClientRect();
      const width = Math.max(1, bounds.width);
      const height = Math.max(1, bounds.height);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    resize();
    animationFrame = requestAnimationFrame(render);

    const visibilityObserver = new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      if (!visible) cancelAnimationFrame(animationFrame);
      if (visible && !wasVisible) animationFrame = requestAnimationFrame(render);
    });
    visibilityObserver.observe(canvas);
  }
</script>
