---
import Navbar from '../components/Navbar.astro';
const { title, description } = Astro.props;
import '../styles/global.css'

---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-white font-serif">
    <Navbar />
    <main class="mx-auto max-w-3xl px-4 pt-6 pb-10 text-lg text-neutral-100 space-y-8">
      <slot />
    </main>
  </body>
</html>
