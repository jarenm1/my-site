---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('digest');
const sortedNotes = notes.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<MainLayout title="Digest" description="Project notes and explanations.">
  <section class="space-y-2">
    {sortedNotes.map((note) => (
      <a href={`/digest/${note.slug}`} class="py-2 px-1 rounded-lg hover:bg-neutral-900/50 transition flex items-center justify-between group">
        <span class="text-lg text-neutral-200 group-hover:text-white underline decoration-blue-300/40 group-hover:decoration-blue-300/80 underline-offset-4">{note.data.title}</span>
        <time class="text-sm text-neutral-600 font-mono group-hover:text-neutral-400 no-underline">{new Date(note.data.date.toISOString().split('T')[0] + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
      </a>
    ))}
  </section>
</MainLayout>
